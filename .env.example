# soif-app configuration. Copy to .env and fill in.
#
# Self-hosted mode makes no outbound calls to any soif-operated service. The
# only external request the app makes is to Google Fonts for the stylesheet.

# --- database -------------------------------------------------------------
# SQLite (default) needs no infrastructure and is right for a single machine.
DATABASE_URL=file:./data/soif.db
# Postgres, for a shared or multi-source deployment:
# DATABASE_URL=postgres://soif:soif@localhost:5432/soif

# --- credential encryption ------------------------------------------------
# Required before any API credential can be stored. 32 bytes, base64 or hex.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means re-entering every stored credential; it is never
# written to the database.
SOIF_ENCRYPTION_KEY=

# --- optional -------------------------------------------------------------
# Pin a specific factor set instead of the bundled one. Download it from a
# release of github.com/Unchained-Labs/soif.
# SOIF_FACTORS_PATH=/etc/soif/factors.json

# Colon-separated Claude Code config directories — one per account. Leave unset
# to discover ~/.claude and ~/.config/claude automatically.
# CLAUDE_CONFIG_DIR=/home/you/.claude:/home/you/.claude-work

# Shared secret required by POST /api/ingest/local-scan when pushing a scan
# from another machine. Unset means the endpoint is not exposed.
# SOIF_PUSH_TOKEN=
