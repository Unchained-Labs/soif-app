{
  "name": "soif-app",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable dashboard for the freshwater your organization's LLM usage consumed.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "soif-init": "./dist/cli/soif-init.js",
    "soif-scan": "./dist/cli/soif-scan.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "tsx cli/soif-scan.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "sync:factors": "tsx scripts/sync-factors.ts",
    "build:cli": "tsup",
    "init": "tsx cli/soif-init.ts",
    "setup": "npm install && npm run init"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "drizzle",
    "factors.json",
    "README.md",
    "LICENSE"
  ]
}
